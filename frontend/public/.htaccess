PassengerAppRoot "/home/u209580425/domains/rukhi.in/public_html"
PassengerAppType node
PassengerStartupFile index.js
PassengerEnabled on

<Files "index.js">
  SetHandler process-with-passenger
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward all API and media requests to Passenger index.js via Pass-Through [PT]
  RewriteCond %{REQUEST_URI} ^/(api|uploads|outputs) [NC]
  RewriteRule ^(.*)$ /index.js [QSA,PT,L]

  # 2. Allow direct access to real static files (Vite CSS, JS, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !^/index\.js$
  RewriteRule ^ - [L]

  # 3. SPA Frontend Route Fallback for all other pages (/dashboard, /editor, /login)
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
