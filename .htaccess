PassengerAppRoot "/home/u209580425/domains/rukhi.in/public_html"
PassengerAppType node
PassengerStartupFile index.js
PassengerEnabled on

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Pass real static files directly (Vite assets, favicon, images, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Route all API, uploads, and outputs requests (GET, POST, PUT, DELETE, OPTIONS) to index.js (Passenger)
  RewriteRule ^api index.js [QSA,L]
  RewriteRule ^uploads index.js [QSA,L]
  RewriteRule ^outputs index.js [QSA,L]

  # 3. SPA Frontend Route Fallback for all other pages (/dashboard, /settings, etc.)
  RewriteRule . /index.html [L]
</IfModule>

# Force browsers and Hostinger Edge CDN (hcdn) to never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
