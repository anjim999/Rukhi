PassengerAppRoot "/home/u209580425/domains/rukhi.in/public_html"
PassengerAppType node
PassengerStartupFile index.js
PassengerEnabled on

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve real static files directly (Vite assets, images, favicon, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Pass all dynamic requests (API endpoints & SPA fallback) to Passenger index.js
  RewriteRule ^ index.js [QSA,L]
</IfModule>

# Force browsers and Hostinger Edge CDN (hcdn) to never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
