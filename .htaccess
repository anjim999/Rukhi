PassengerAppRoot "/home/u209580425/domains/rukhi.in/public_html"
PassengerAppType node
PassengerStartupFile index.js
PassengerEnabled on

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct access to real static files (Vite build assets, images, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. For POST/PUT/DELETE API requests: rewrite to /index.js with Pass-Through [PT]
  RewriteCond %{REQUEST_METHOD} !^GET$ [NC]
  RewriteCond %{REQUEST_URI} ^/(api|uploads|outputs)
  RewriteRule ^(.*)$ /index.js [QSA,PT,L]

  # 3. For GET API requests: pass directly to Phusion Passenger without rewriting
  RewriteCond %{REQUEST_METHOD} ^GET$ [NC]
  RewriteCond %{REQUEST_URI} ^/(api|uploads|outputs)
  RewriteRule ^ - [L]

  # 4. SPA Frontend Route Fallback for all other pages (/dashboard, /settings, etc.)
  RewriteRule . /index.html [L]
</IfModule>

# Force browsers and Hostinger Edge CDN (hcdn) to never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
