PassengerAppRoot "/home/u209580425/domains/rukhi.in/public_html"
PassengerAppType node
PassengerStartupFile index.js
PassengerEnabled on

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward /api, /uploads, /outputs to Phusion Passenger entry point /index.js
  RewriteRule ^api/(.*)$ /index.js [PT,L]
  RewriteRule ^uploads/(.*)$ /index.js [PT,L]
  RewriteRule ^outputs/(.*)$ /index.js [PT,L]

  # 2. Allow direct access to real static files (Vite build assets, images, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Frontend Route Fallback for all other pages (/dashboard, /settings, etc.)
  RewriteRule . /index.html [L]
</IfModule>

# Force browsers and Hostinger Edge CDN (hcdn) to never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
