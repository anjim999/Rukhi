<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reverse proxy /api, /uploads, /outputs to Node.js Express server on localhost:5000
  RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
  RewriteRule ^uploads/(.*)$ http://127.0.0.1:5000/uploads/$1 [P,L]
  RewriteRule ^outputs/(.*)$ http://127.0.0.1:5000/outputs/$1 [P,L]

  # 2. Allow direct access to real static files (Vite build assets, images, etc)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Frontend Route Fallback
  RewriteRule . /index.html [L]
</IfModule>

# Force browsers and Hostinger Edge CDN (hcdn) to never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
